# GEMINI_API_KEY: Required for optional Gemini AI Anomaly Summarization.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# APAAR_HMAC_SECRET: Server-side secret key for HMAC-SHA256 privacy-preserving APAAR tokenization.
APAAR_HMAC_SECRET="sih26263-apaar-setu-hmac-server-secret-2026"

# APAAR_SIGNING_SEED: Server-side seed for Ed25519 digital credential signing keypair.
APAAR_SIGNING_SEED="sih26263-apaar-setu-ed25519-signing-seed-2026"

